generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COACH
  ATHLETE
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrainingType {
  PHYSICAL
  COLLECTIVE
  MIXED
  MATCH
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole
  photoUrl     String?
  birthDate    DateTime?    @db.Date
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  teams        Team[]       @relation("CoachTeams")
  memberships  Membership[]
}

model Team {
  id          String       @id @default(cuid())
  name        String
  modality    String
  code        String       @unique
  objectiveCriteria Json?
  qualitativeCriteria Json?
  coachId     String
  coach       User         @relation("CoachTeams", fields: [coachId], references: [id])
  memberships Membership[]
  evaluationProfiles EvaluationProfile[]
  trainings   Training[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String           @id @default(cuid())
  teamId    String
  athleteId String
  status    MembershipStatus @default(PENDING)
  number    Int?
  position  String?
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete   User             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([teamId, athleteId])
}

model Training {
  id          String       @id @default(cuid())
  teamId      String
  date        DateTime
  type        TrainingType
  description String?
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  records     TrainingRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TrainingRecord {
  id         String       @id @default(cuid())
  trainingId String
  athleteId  String
  present    Boolean      @default(true)
  training   Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  metrics    SportMetric[]
  evaluation Evaluation?
  modalitySnapshot String?
  positionSnapshot String?
  roleSnapshot String?
  goalkeeperStats GoalkeeperStats?
  measurements TrainingMeasurement[]
  measurementsInitialized Boolean @default(false)

  @@unique([trainingId, athleteId])
}

model Evaluation {
  id                  String         @id @default(cuid())
  recordId            String         @unique
  technique           Int            @default(5)
  physicalCondition   Int            @default(5)
  participation       Int            @default(5)
  teamwork            Int            @default(5)
  source              String @default("LEGACY")
  modality            String?
  position            String?
  role                String?
  finalScore          Float?
  criteria            EvaluationCriterion[]
  record              TrainingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model SportMetric {
  id       String         @id @default(cuid())
  recordId String
  name     String
  value    Int            @default(0)
  record   TrainingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, name])
}

// Team configuration is mutable; evaluation criteria below are independent snapshots.
model EvaluationProfile {
  schemaVersion Int @default(1)
  legacyCriteria Json?
  id String @id @default(cuid())
  teamId String
  modality String
  role String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  criteria ProfileCriterion[]
  @@unique([teamId, modality, role])
}
model ProfileCriterion {
  archived Boolean @default(false)
  kind String @default("QUALITATIVE")
  id String @id @default(cuid())
  profileId String
  name String
  weight Float
  order Int
  profile EvaluationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, kind, archived])
}
model EvaluationCriterion {
  criterionId String?
  id String @id @default(cuid())
  evaluationId String
  name String
  weight Float
  score Float
  order Int
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  @@unique([evaluationId, name])
}
model GoalkeeperStats {
  id String @id @default(cuid())
  recordId String @unique
  saves Int?
  goalsConceded Int?
  shotsOnTarget Int?
  difficultSaves Int?
  accurateDistributions Int?
  distributionAttempts Int?
  successfulExits Int?
  exitAttempts Int?
  record TrainingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

// Independent names and values survive changes/removal of the configured criterion.
model TrainingMeasurement {
  id String @id @default(cuid())
  recordId String
  criterionId String
  name String
  role String
  value Int?
  order Int
  record TrainingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  @@unique([recordId, criterionId])
}
