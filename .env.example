# Nunca copie credenciais reais para arquivos versionados.
DATABASE_URL="mysql://webkore_app:CHANGE_ME@127.0.0.1:3306/webkore"
# Gere um valor aleatório exclusivo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_random_secret"
PORT=3333
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
AUTH_SESSION_SECONDS=86400
AUTH_LOGIN_LIMIT=20
AUTH_REGISTER_LIMIT=10
API_RATE_LIMIT=3000
# Apenas se houver proxy reverso local; nunca use true ou 0.0.0.0/0.
