{
  "name": "webkore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "check:structure": "node scripts/check-structure.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "test:css:baseline": "node qa/structure/visual-check.mjs before --css",
    "test:css:visual": "node qa/structure/visual-check.mjs after --css",
    "test:structure:visual": "node qa/structure/visual-check.mjs after",
    "test:integration": "node tests/integracao/api.check.js",
    "test:build": "node scripts/check-build.mjs",
    "test:privacy": "node tests/integracao/privacy.check.js",
    "test:privacy:browser": "node tests/integracao/privacy.check.js --browser",
    "api": "node server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "legal:publish": "node prisma/publish-legal.js",
    "prisma:seed": "prisma db seed",
    "prisma:seed:test": "node prisma/seed.js --test",
    "test:positions:integration": "node tests/integracao/positions.check.js",
    "test:ct20": "node qa/ct20/run.mjs",
    "test:ct20:install": "playwright install chromium",
    "test:security": "node qa/ct20/run.mjs --security"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "overrides": {
    "qs": "^6.16.2",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
